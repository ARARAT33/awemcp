NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Generate a long random value; clients must send it as Authorization: Bearer <value>
MCP_ACCESS_TOKEN=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Exactly 32 bytes, base64 encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
BLOGGER_BLOG_URL=https://blogma-wa.blogspot.com/
